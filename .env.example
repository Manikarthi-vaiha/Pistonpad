# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/spares
# Long random string used to sign login sessions (openssl rand -base64 32)
SESSION_SECRET=change-me
# First owner account, created by `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Only for docker compose: password for the bundled PostgreSQL
POSTGRES_PASSWORD=change-me
